    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-http-backend": "^3.0.2",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4.1",
    "react-otp-input": "^3.1.1",
    "react-phone-number-input": "^3.4.12",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.0",
    "styled-components": "^6.1.17"
